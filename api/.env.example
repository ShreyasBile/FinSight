# ── OCR provider selection ───────────────────────────────────────────────
# mock      → no model needed, returns canned data (great for wiring/dev)
# ollama    → local Qwen2.5-VL (or any vision model) via Ollama  [recommended local]
# anthropic → server-side Claude vision (needs a key; no GPU required)
OCR_PROVIDER=mock

# ── Ollama (local VLM) ───────────────────────────────────────────────────
# Install Ollama, then: `ollama pull qwen2.5vl:7b`
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
# Context window per request (tokens). Ollama's own default (4096) is too
# small once a multi-page doc (e.g. Aadhaar front+back) becomes 2+ images —
# that alone can use ~4300 tokens and gets rejected with "exceeds the
# available context size". Raise further if you see that error with more pages.
OLLAMA_NUM_CTX=8192

# ── Anthropic (server-side, optional) ────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_VERSION=2023-06-01

# ── Image preprocessing (OpenCV + EasyOCR) ───────────────────────────────
# Cleans phone-photo scans before the model: EXIF fix, auto-orient (12-angle
# EasyOCR scoring), document warp, deskew, and adaptive brightness/contrast/
# sharpen/denoise. Big accuracy win on rotated/dark/blurry uploads; costs a few
# seconds and pulls in torch (~2GB). Set false to send raw images to the model.
OCR_PREPROCESS=true
# Background removal via rembg/U2Net (needs: pip install rembg onnxruntime).
PREPROCESS_SEGMENT=false

# ── Service ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
MAX_FILE_MB=15
PDF_MAX_PAGES=4
