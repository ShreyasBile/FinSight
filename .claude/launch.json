{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "api",
      "runtimeExecutable": ".venv-agents/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--port",
        "8000"
      ],
      "cwd": "api",
      "port": 8000
    },
    {
      "name": "report",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8891",
        "--directory",
        "D:/novacinternship/document_tampering/reports"
      ],
      "port": 8891,
      "autoPort": true
    },
    {
      "name": "docs",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8892",
        "--directory",
        "docs"
      ],
      "port": 8892,
      "autoPort": true
    }
  ]
}